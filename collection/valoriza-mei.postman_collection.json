{
  "info": {
    "name": "Valoriza MEI API",
    "description": "API REST do Valoriza MEI (Projeto Final II, UNISINOS).\n\nOrdem sugerida: 1. Autenticação (Cadastro e Login), 2. Produtos, 3. Despesas e parâmetros, 4. Precificação,\n5. Estoque e fluxo de caixa, 6. Datas comemorativas e alertas.\n\nO Login guarda o token na variável {{token}}, usada por todas as requisições protegidas (Bearer).\nOs cadastros guardam o id criado ({{produtoId}}, {{despesaId}}, {{movimentacaoId}}, {{dataComemorativaId}}).\nOs exemplos usam o estudo de caso da loja de ferramentas (seção 4.1 do artigo).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "email",
      "value": "carlos@lojaferramentas.com.br"
    },
    {
      "key": "senha",
      "value": "Senha@2026"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "produtoId",
      "value": ""
    },
    {
      "key": "despesaId",
      "value": ""
    },
    {
      "key": "movimentacaoId",
      "value": ""
    },
    {
      "key": "dataComemorativaId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Saúde e documentação",
      "description": "Endpoints públicos da aplicação.",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            },
            "description": "Saúde da aplicação: {\"status\":\"UP\"}.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Especificação OpenAPI",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v3/api-docs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v3",
                "api-docs"
              ]
            },
            "description": "Especificação OpenAPI 3.1 (JSON). O Swagger UI fica em /swagger-ui.html.",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "1. Autenticação (RF10)",
      "description": "Cadastro da conta, login (guarda o token) e conta autenticada.",
      "item": [
        {
          "name": "Cadastro de conta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/cadastro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "cadastro"
              ]
            },
            "description": "Cria o MEI e o usuário. 409 se o e-mail já existir (com o spring-boot:test-run o banco é recriado a cada subida). Senha de 8 a 72 caracteres.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nomeNegocio\": \"Loja de Ferramentas\",\n  \"nome\": \"Carlos Silva\",\n  \"email\": \"{{email}}\",\n  \"senha\": \"{{senha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Devolve o token JWT (válido por 60 minutos) e o guarda em {{token}}.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"senha\": \"{{senha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set(\"token\", pm.response.json().token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Conta autenticada",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/conta",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "conta"
              ]
            },
            "description": "Dados da conta do token."
          }
        }
      ]
    },
